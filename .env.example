# ============================================================
# StockPro - MediCare Industries
# Variables d'environnement - EXEMPLE
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# ------ Application Django ------
SECRET_KEY=votre-cle-secrete-django-tres-longue-et-aleatoire-ici
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------ Base de données PostgreSQL ------
DB_NAME=stockpro_db
DB_USER=stockpro_user
DB_PASSWORD=votre_mot_de_passe_securise
DB_HOST=localhost
DB_PORT=5432

# ------ Redis & Celery ------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------ Email (SMTP) ------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-app

# ------ Fichiers Media & Static ------
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# ------ Informations Entreprise ------
COMPANY_NAME=MediCare Industries
COMPANY_ADDRESS=Zone Industrielle, Meknès, Maroc
COMPANY_PHONE=+212 5XX-XXXXXX
COMPANY_EMAIL=contact@medicare-industries.ma
COMPANY_ICE=000000000000000
COMPANY_RC=12345

# ------ Sécurité (Production uniquement) ------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ------ Logs ------
LOG_LEVEL=DEBUG
LOG_FILE=logs/stockpro.log
